[Unit]
Description=PaperTrace exam paper search website
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=papertrace
Group=papertrace
WorkingDirectory=/opt/papertrace/current
ExecStart=/opt/papertrace/venv/bin/python -u /opt/papertrace/current/serve.py --host 0.0.0.0 --port 8001
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/papertrace/papertrace.env
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

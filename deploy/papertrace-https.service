[Unit]
Description=PaperTrace HTTPS and automatic certificate renewal
After=network-online.target papertrace.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=papertrace
Group=papertrace
ExecStart=/usr/local/bin/papertrace-caddy run --config /etc/papertrace/Caddyfile --adapter caddyfile
Environment=XDG_DATA_HOME=/var/lib/papertrace-caddy
Environment=XDG_CONFIG_HOME=/var/lib/papertrace-caddy
StateDirectory=papertrace-caddy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
